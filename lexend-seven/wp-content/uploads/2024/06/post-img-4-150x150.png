<link rel='stylesheet' id='lexend-custom-css' href='https://lexend.themegenix.com/seven/wp-content/themes/lexend/assets/css/lexend-custom.css?ver=6.8.5' type='text/css' media='all' />
<style id='lexend-custom-inline-css' type='text/css'>
html:root {
            --bs-primary: #16404b;
            --color-primary: #16404b;
            --unit-primary-color: #16404b;
            --bs-primary-rgb: 22, 64, 75;
        }
html:root {
            --bs-secondary-rgb: 245, 238, 233;
            --bs-secondary: #f5eee9;
            --unit-secondary-color: #f5eee9;
        }
.btn-primary {
            --bs-btn-bg: #16404b !important;
            --bs-btn-border-color: #16404b !important;
            --bs-btn-disabled-bg: #16404b !important;
            --bs-btn-disabled-border-color: #16404b !important;
        }
.btn-primary {
            --bs-btn-hover-bg: #133640 !important;
            --bs-btn-hover-border-color: #133640 !important;
            --bs-btn-active-bg: #133640 !important;
            --bs-btn-active-border-color: #133640 !important;
        }
